            from {
                stroke-dashoffset: 200;
            }
            to {
                stroke-dashoffset: 0;
            }
        }
        .animate-draw-line {
            stroke-dasharray: 200;
            stroke-dashoffset: 200;
            animation: drawLine 1.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            animation-delay: 0.5s;
