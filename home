    <script>
        // Initialize Feather Icons
        feather.replace();

        // Mobile Menu Toggle logic
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');

        btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
        });
        
        // Close menu when clicking on any mobile nav links
        const mobileLinks = menu.querySelectorAll('a');
        mobileLinks.forEach(link => {
            link.addEventListener('click', () => {
                menu.classList.add('hidden');
            });
        });
        
        // Navbar Scrolled Effect
        window.addEventListener('scroll', () => {
            const nav = document.querySelector('nav');
            if (window.scrollY > 10) {
                nav.classList.add('shadow-sm');
            } else {
                nav.classList.remove('shadow-sm');
            }
        });

        // FAQ Accordion Logic
        const faqButtons = document.querySelectorAll('.faq-button');
        faqButtons.forEach(button => {
            button.addEventListener('click', () => {
                const content = button.nextElementSibling;
                const icon = button.querySelector('.faq-icon');
                
                // Toggle current FAQ content visibility
                content.classList.toggle('hidden');
                
                // Toggle rotation of feather icon
                if (content.classList.contains('hidden')) {
                    icon.classList.remove('rotate-180');
                } else {
                    icon.classList.add('rotate-180');
                }
            });
        });

        // Copy Referral Link Functionality with Modern Toast
        function copyReferralLink() {
            // Text to copy
            const textToCopy = "binausaha.com/ref?id=m5921";
            
            // Safe copy fallback for inside iframe sandboxes
            const tempInput = document.createElement("input");
            tempInput.value = textToCopy;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand("copy");
            document.body.removeChild(tempInput);

            // Trigger beautiful interactive toast
            showToast("Berhasil disalin ke clipboard!");
        }

        function showToast(message) {
            const container = document.getElementById('toast-container');
            
            // Create Toast Element
            const toast = document.createElement('div');
            toast.className = "flex items-center gap-2 bg-navy text-white text-xs font-bold px-4 py-3 rounded-xl shadow-2xl border border-white/10 transform translate-y-5 opacity-0 transition-all duration-300 pointer-events-auto";
            toast.innerHTML = `
                <span class="w-2 h-2 rounded-full bg-green-400"></span>
                <span>${message}</span>
            `;
            
            container.appendChild(toast);

            // Animate In
            setTimeout(() => {
                toast.classList.remove('translate-y-5', 'opacity-0');
            }, 50);

            // Animate Out & Destroy
            setTimeout(() => {
                toast.classList.add('translate-y-[-5px]', 'opacity-0');
                setTimeout(() => {
                    toast.remove();
                }, 300);
            }, 3000);
        }

        // Initialize Scroll Reveal Observer for "Mengapa Memilih Ekosistem BinaUsaha" Cards
        const observerOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.15 // Animasi dimulai saat 15% dari kartu terlihat di layar
        };

        const revealObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('reveal-active');
                    observer.unobserve(entry.target); // Hanya menganimasikan sekali
                }
            });
        }, observerOptions);

        document.querySelectorAll('.reveal-left, .reveal-right').forEach(el => {
            revealObserver.observe(el);
        });
    </script>
